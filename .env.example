# Supabase project connection. The publishable key is safe for the browser;
# the secret key must exist only in Render/backend environment variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
SUPABASE_SECRET_KEY=replace-with-a-new-rotated-secret-key

# Access control
ADMIN_EMAILS=admin@example.com

# Application
APP_NAME=Hich Studio
ENVIRONMENT=development
PUBLIC_APP_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8000
COOKIE_SECURE=false
ACCESS_COOKIE_MAX_AGE=3600
REFRESH_COOKIE_MAX_AGE=2592000

# Optional extra pepper for hashed signing links. Generate a long random value
# for production (for example: `openssl rand -hex 32`).
TOKEN_HASH_PEPPER=replace-with-a-long-random-value

# Optional: used only by the one-time admin bootstrap command. Never commit a
# real password. Remove these variables after the account has been created.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-one-time-password
